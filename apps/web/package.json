  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": "^20.0.0"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 0,
